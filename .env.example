# Google Gemini API key (get one free at https://aistudio.google.com/apikey). Required for AI mode (the default); without it Generate returns 503 with setup steps.
AI_API_KEY=your-gemini-api-key-here
# Gemini model name (defaults to gemini-2.5-flash when empty)
AI_MODEL=gemini-3-flash-preview
# Optional AI request timeout in seconds (default 90)
AI_TIMEOUT_SECONDS=90
# Optional port for the Flask server (default 5000)
PORT=5000
