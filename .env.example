# Google Gemini API key (get one free at https://aistudio.google.com/apikey). Leave empty to use demo mode.
AI_API_KEY=
# Gemini model name (defaults to gemini-2.5-flash when empty)
AI_MODEL=
# Optional AI request timeout in seconds (default 60)
AI_TIMEOUT_SECONDS=
# Optional port for the Flask server (default 5000)
PORT=
